DEV_PORT=5173
CHOKIDAR_USEPOLLING=false
CHOKIDAR_INTERVAL=100
# Override the command the container runs once your app exists, e.g.:
# DEV_COMMAND=npm run dev -- --host 0.0.0.0 --port 5173
# HTTPS=1 serves the dev server over a self-signed certificate, so a VR
# headset on the same Wi-Fi can open it (https://<this machine's IP>:5173).
HTTPS=0
# Quest packaging (docs/QUEST-PACKAGING.md): folder on this machine holding the app's signing key,
# mounted into the container at /home/node/signing. Keep it outside the repo and back it up
# (key file and passwords): without it the Horizon Store app can never be updated.
# SIGNING_DIR=/absolute/path/to/android-signing/orrery-clock
